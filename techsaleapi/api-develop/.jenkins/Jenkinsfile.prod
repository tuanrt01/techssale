pipeline {
    agent any;

    stages {
        stage("deploy") {
            steps {
                script {
                    try {
                        triggeredUser = currentBuild.rawBuild.getCause(Cause.UserIdCause).getUserName()
                        mattermostSend(
                            color: 'warning',
                            message: "🔄 Starting Deployment: *${env.JOB_NAME}* #${env.BUILD_NUMBER} (<${env.BUILD_URL}|View Details>)",
                            text: "${triggeredUser} started the pipeline!!!"
                        )
                        updateGitlabCommitStatus name: 'Deploy Techzai Production', state: 'running'

                        sshagent(credentials: ['192.168.13.4-ssh']) {
                            sh '''
                                ssh -o StrictHostKeyChecking=no -l $SSH_13_4_USER 192.168.13.4 -p $SSH_13_4_PORT << END
                                cd /home/techzen/docker/products/techsale
                                ./git_pull.sh
                                cd ..
                                docker compose up -d --build techsale-api
                            '''
                        }

                        updateGitlabCommitStatus name: 'Deploy Techzai Production', state: 'success'
                        mattermostSend(
                            color: 'good',
                            message: "🚀 Successful Deployment: *${env.JOB_NAME}* #${env.BUILD_NUMBER} (<${env.BUILD_URL}|View Details>)"
                        )
                    } catch (Exception e) {
                        mattermostSend(
                            color: 'danger',
                            message: "🚨 Failed Pipeline: *${env.JOB_NAME}* #${env.BUILD_NUMBER} (<${env.BUILD_URL}|View Details>)"
                        )
                        updateGitlabCommitStatus name: 'Deploy Techzai Production', state: 'failed'
                        error 'Deployment failed!'
                    }
                }
            }
        }
    }
}